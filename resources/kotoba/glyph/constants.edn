;; Constants extracted from kami-text (Rust, deleted-not-migrated, recovered
;; from kotoba-lang/kami-engine git history at ADR-2607010930 Phase 4). Every
;; magic number below has a direct counterpart in the original `src/lib.rs`;
;; see the doc-comment on each consuming fn in `kotoba.glyph.*` for the exact
;; Rust symbol it mirrors.

{;; Unicode codepoint ranges used for font-slot / script classification.
 ;; [lo hi] inclusive, decimal (source used hex literals).
 :cjk-ranges       [[12288 12351]    ; 0x3000-0x303F  CJK punctuation
                     [12352 12447]   ; 0x3040-0x309F  Hiragana
                     [12448 12543]   ; 0x30A0-0x30FF  Katakana
                     [12784 12799]   ; 0x31F0-0x31FF  Katakana phonetic ext.
                     [13312 19903]   ; 0x3400-0x4DBF  CJK ext. A
                     [19968 40959]   ; 0x4E00-0x9FFF  CJK unified ideographs
                     [63744 64255]   ; 0xF900-0xFAFF  CJK compatibility ideographs
                     [65280 65519]]  ; 0xFF00-0xFFEF  halfwidth/fullwidth forms

 :emoji-ranges     [[127462 127487] ; 0x1F1E6-0x1F1FF regional indicators
                     [127744 130047] ; 0x1F300-0x1FAFF misc emoji blocks
                     [9728 10175]    ; 0x2600-0x27BF   misc symbols/dingbats
                     [65039 65039]   ; 0xFE0F           variation selector-16
                     [8205 8205]]    ; 0x200D           ZWJ

 :combining-ranges [[768 879]        ; 0x0300-0x036F combining diacriticals
                     [6832 6911]     ; 0x1AB0-0x1AFF combining diacriticals ext.
                     [7616 7679]     ; 0x1DC0-0x1DFF combining diacriticals supp.
                     [8400 8447]     ; 0x20D0-0x20FF combining diacriticals for symbols
                     [65056 65071]]  ; 0xFE20-0xFE2F combining half marks

 :rtl-ranges       [[1424 2303]      ; 0x0590-0x08FF Hebrew/Arabic/Syriac/...
                     [64285 65023]   ; 0xFB1D-0xFDFF Hebrew/Arabic presentation forms A
                     [65136 65279]   ; 0xFE70-0xFEFF Arabic presentation forms B
                     [67584 69631]]  ; 0x10800-0x10FFF various RTL scripts

 :regional-indicator-range [127462 127487] ; 0x1F1E6-0x1F1FF, flag-pair clustering

 ;; Uniform-grid mono (SDF) atlas packing. Mirrors
 ;; `build_font_atlas_from_inventory`: NOT a general bin-packer — every cell
 ;; is the same size, sized from `font-size` alone.
 :mono-atlas {:cols 16 :cell-w-ratio 1.20 :cell-h-ratio 1.55}

 ;; Uniform-grid color/emoji atlas packing. Mirrors
 ;; `build_color_glyph_atlas_from_clusters`.
 :color-atlas {:cols 8 :cell-size-ratio 1.4 :cell-min 24}

 ;; Procedural ASCII placeholder SDF atlas (no font backend). Mirrors
 ;; `FontAtlas::ascii_procedural`.
 :ascii-procedural {:cols 16 :rows 6 :first-codepoint 32 :count-glyphs 96
                     :cell-w-ratio 0.6 :glyph-h-ratio 1.0
                     :bearing-y-ratio 0.8 :advance-ratio 0.6
                     :line-height-ratio 1.2
                     :sdf-scale 4.0 :sdf-bias 128.0}

 ;; Dynamic glyph-set capacity floors + pinned (never-evicted) entries.
 ;; Mirrors `DynamicGlyphAtlas::new_default` / `DynamicColorGlyphAtlas::new`.
 :capacity {:mono-min 32 :color-min 8}
 :pinned   {:mono [\space \?] :color ["✨"]} ; space, '?', sparkles

 ;; Layout fallback cursor-advance ratios (unshaped path). Mirrors
 ;; `layout_text_shaped`'s no-manager branch and `layout_color_glyphs`.
 :layout {:min-cluster-advance-ratio 2.0
          :missing-glyph-advance-ratio 8.0
          :missing-color-glyph-advance-ratio 0.35}}
